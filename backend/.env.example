# App
APP_NAME=OrmocTransportApp
DEBUG=True
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+psycopg2://user:password@server:port/database

# Security
SECRET_KEY=secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Password hashing config
BCRYPT_ROUNDS=12

# CORS
ALLOWED_ORIGINS=localhost,react,expo,domain

# Geofence
GEOFENCE_DWELL_THRESHOLD_SECONDS=45

# GPS Ping interval
GPS_PING_INTERVAL_SECONDS=5

# OSRM routing API
OSRM_API_URL=http://router.project-osrm.org

# Broadcast notification cleanup 
BROADCAST_RETENTION_HOURS=24

# Default admin seed credentials
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme123