# App
APP_NAME=OrmocTransportApp
DEBUG=True
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+psycopg2://user:password@server:port/database

# Security
# You can use this and run in your terminal (venv acivated) for generating your own secret key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Password hashing config
BCRYPT_ROUNDS=12

# CORS
ALLOWED_ORIGINS=localhost,react,expo,domain

# Geofence
GEOFENCE_DWELL_THRESHOLD_SECONDS=45

# GPS Ping interval
GPS_PING_INTERVAL_SECONDS=5

# OSRM routing API
OSRM_API_URL=http://router.project-osrm.org

# Broadcast notification cleanup 
BROADCAST_RETENTION_HOURS=24

# Default admin seed credentials
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme123
SEED_ADMIN_EMAIL=admin-account-email@gmail.com # change this into a valid gmail address

# SMTP password-reset delivery (use an app password for Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=true
WEB_APP_URL=http://localhost:5173
