# Public Mapbox token used by the installed driver app to load map styles and tiles.
# Create this token in Mapbox; it begins with pk.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=mapboxtoken

# Backend API used by the driver app. For USB development, run
# `adb reverse tcp:8000 tcp:8000` and use the loopback URL below. For Wi-Fi
# testing, replace it with your computer's reachable LAN address and port.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Do not put the Mapbox Downloads:Read secret token in this file or any project
# .env file that could be committed. Configure that token only in local Gradle
# settings or your CI/EAS secret store before creating a native build.
